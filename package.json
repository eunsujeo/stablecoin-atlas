{
  "name": "multi-chain-asset-compatibility-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "node --use-env-proxy --import tsx --test --test-concurrency=2 tests/*.test.ts tests/*.test.mjs web/*.test.mjs",
    "test:unit": "node --use-env-proxy --import tsx --test tests/domain.test.ts",
    "lab": "node --use-env-proxy --import tsx src/cli.ts lab",
    "assess": "node --use-env-proxy --import tsx src/cli.ts assess",
    "validate": "node --use-env-proxy --import tsx src/cli.ts validate",
    "check": "npm run build && npm test",
    "research:solana-mints": "node --use-env-proxy --import tsx src/research/solana-mint-cli.ts",
    "research:xrpl-issuers": "node --use-env-proxy --import tsx src/research/xrpl-issuer-cli.ts",
    "tvm:smoke": "node --use-env-proxy --import tsx src/tron/lab/smoke.ts",
    "tvm:deploy": "node --use-env-proxy --import tsx src/tron/lab/deploy-cli.ts",
    "tvm:exercise": "node --use-env-proxy --import tsx src/tron/lab/deploy-cli.ts --exercise",
    "tvm:boundary": "node --use-env-proxy --import tsx src/tron/lab/deploy-cli.ts --boundary",
    "tvm:negative": "node --use-env-proxy --import tsx src/tron/lab/negative-cli.ts",
    "tvm:validate": "node --use-env-proxy --import tsx src/tron/lab/report-cli.ts",
    "tvm:allowance-negative": "node --use-env-proxy --import tsx src/tron/lab/allowance-cli.ts",
    "ui": "node tools/ui-preview.mjs",
    "evidence:build": "node --import tsx tools/evidence-build.mjs",
    "market:build": "node tools/market-build.mjs",
    "market:collect": "node --use-env-proxy tools/market-collect.mjs",
    "market:watch": "node --use-env-proxy tools/market-watch.mjs",
    "setup": "node tools/workspace-setup.mjs",
    "doctor": "node tools/workspace-doctor.mjs",
    "doctor:full": "node tools/workspace-doctor.mjs full",
    "with-env": "node tools/workspace-env.mjs",
    "workspace:export": "node --import tsx tools/workspace-transfer.mjs export",
    "workspace:import": "node --import tsx tools/workspace-transfer.mjs import",
    "check:ui": "node --use-env-proxy --import tsx --test --test-concurrency=2 web/*.test.mjs",
    "compiler:prepare": "node --use-env-proxy --import tsx tools/prepare-tron-compiler.ts",
    "market:db:check": "node --use-env-proxy tools/market-db/cli.mjs check",
    "market:db:init": "node --use-env-proxy tools/market-db/cli.mjs init",
    "market:db:partition": "node --use-env-proxy tools/market-db/cli.mjs partition",
    "market:db:grant": "node --use-env-proxy tools/market-db/cli.mjs grant",
    "market:db:plan": "node --use-env-proxy tools/market-db/cli.mjs plan",
    "market:db:import": "node --use-env-proxy tools/market-db/cli.mjs import",
    "market:db:series": "node --use-env-proxy tools/market-db/cli.mjs series",
    "market:db:latest": "node --use-env-proxy tools/market-db/cli.mjs latest",
    "market:db:history": "node --use-env-proxy tools/market-db/cli.mjs history",
    "check:db": "node --use-env-proxy --test --test-concurrency=1 tests/postgres/*.test.mjs",
    "market:db:networks": "node --use-env-proxy tools/market-db/cli.mjs networks",
    "market:db:network-history": "node --use-env-proxy tools/market-db/cli.mjs network-history",
    "market:catalog:init": "node --use-env-proxy tools/market-db/catalog-cli.mjs init",
    "market:catalog:import": "node --use-env-proxy tools/market-db/catalog-cli.mjs import",
    "market:catalog:grant": "node --use-env-proxy tools/market-db/catalog-cli.mjs grant",
    "market:history:upgrade": "node --use-env-proxy tools/market-db/history-cli.mjs upgrade",
    "market:history:init": "node --use-env-proxy tools/market-db/history-cli.mjs init",
    "market:history:grant": "node --use-env-proxy tools/market-db/history-cli.mjs grant",
    "market:history:collect": "node --use-env-proxy tools/market-db/history-cli.mjs collect",
    "market:history:import": "node --use-env-proxy tools/market-db/history-cli.mjs import",
    "collector:run": "node --use-env-proxy tools/collector-worker.mjs run",
    "collector:status": "node --use-env-proxy tools/collector-worker.mjs status",
    "market:history:normalize": "node --use-env-proxy tools/market-db/history-cli.mjs normalize",
    "market:history:grant-writer": "node --use-env-proxy tools/market-db/history-cli.mjs grant-writer",
    "market:history:continuous": "node --use-env-proxy tools/market-db/history-cli.mjs continuous"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "pg": "8.23.1",
    "solc": "0.8.37",
    "tronweb": "6.5.1",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "overrides": {
    "tmp": "0.2.7",
    "tronweb": {
      "axios": "1.20.0"
    }
  }
}
