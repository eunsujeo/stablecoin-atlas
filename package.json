{
  "name": "multi-chain-asset-compatibility-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "node --use-env-proxy --import tsx --test tests/*.test.ts",
    "test:unit": "node --use-env-proxy --import tsx --test tests/domain.test.ts",
    "lab": "node --use-env-proxy --import tsx src/cli.ts lab",
    "assess": "node --use-env-proxy --import tsx src/cli.ts assess",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "solc": "0.8.37",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "8.20.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
