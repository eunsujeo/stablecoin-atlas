[Unit]
Description=Restricted Atlas deployment poll trigger (no runner, code or secrets)
After=network-online.target
[Service]
Type=oneshot
User=atlaspull
Group=atlaspull
ExecStart=/usr/bin/systemctl start --no-block atlas-deploy-apply.service
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
UMask=0077
MemoryMax=48M
TasksMax=8
TimeoutStartSec=15
