[Unit]
Description=Dashboard-managed Cloudflare Tunnel for Atlas web only
After=network-online.target atlas-web.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=atlastunnel
Group=atlastunnel
LoadCredential=tunnel.token:/etc/atlas-tunnel/tunnel.token
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate --metrics 127.0.0.1:49312 run --token-file ${CREDENTIALS_DIRECTORY}/tunnel.token
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
InaccessiblePaths=-/etc/atlas-web -/etc/atlas-collector -/var/lib/atlas-collector -/opt/stablecoin-atlas
MemoryHigh=192M
MemoryMax=256M
TasksMax=64
UMask=0077

[Install]
WantedBy=multi-user.target
