[Unit]
Description=Daily registered stablecoin collection for selection %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=900
StartLimitBurst=3

[Service]
Type=exec
User=atlascollector
Group=atlascollector
WorkingDirectory=/opt/multi-chain-asset-compatibility
ExecStartPre=/usr/bin/env node tools/collector-deploy.mjs check --kind registered --selection %i --env-file /etc/atlas-collector/registered-writer.env --state-root /var/lib/atlas-collector
ExecStart=/usr/bin/env node --use-env-proxy tools/registered-collector.mjs run --env-file /etc/atlas-collector/registered-writer.env --selection %i --state-dir /var/lib/atlas-collector/receipts --archive-dir /var/lib/atlas-collector/archive
Restart=on-failure
RestartSec=60
TimeoutStopSec=45
StateDirectory=atlas-collector
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/atlas-collector

[Install]
WantedBy=multi-user.target
