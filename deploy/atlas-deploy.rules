// No shell, arbitrary systemctl, stop, restart, unit-file, or SSH/runner permission.
polkit.addRule(function(action, subject) {
    if (subject.user === "atlaspull" &&
        action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") === "atlas-deploy-apply.service" &&
        action.lookup("verb") === "start") {
        return polkit.Result.YES;
    }
});
