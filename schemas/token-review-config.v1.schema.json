{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "network",
    "token"
  ],
  "properties": {
    "schemaVersion": {
      "const": "TokenReviewConfig1.0"
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chainId"
      ],
      "properties": {
        "chainId": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,77}$"
        },
        "blockNumber": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        }
      }
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address"
      ],
      "properties": {
        "address": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^0x[0-9a-fA-F]{40}$"
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "address",
          "contract",
          "compilerVersion",
          "inputFile"
        ],
        "properties": {
          "address": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "contract": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "compilerVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "inputFile": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    },
    "audits": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file"
        ],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "publisher": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "declaredTarget": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "commit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "scope": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              }
            }
          }
        }
      }
    },
    "probes": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "address",
          "signature",
          "args"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "address": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "signature": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "args": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 512
                },
                {
                  "type": "boolean"
                }
              ]
            }
          }
        }
      }
    }
  }
}
