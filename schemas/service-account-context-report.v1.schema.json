{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Local service-account context validation, not AssessmentReport",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "kind": {
      "const": "LOCAL_SERVICE_ACCOUNT_CONTEXT_VALIDATION_NOT_ASSESSMENT"
    },
    "inputStatus": {
      "const": "LOCAL_INPUT_VALIDATED_NOT_ACCOUNT_VERIFIED"
    },
    "inputSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inputHashEncoding": {
      "const": "SHA256_RAW_UTF8_BYTES"
    },
    "profileId": {
      "enum": [
        "ethereum-usdc",
        "ethereum-usdt",
        "ethereum-rlusd",
        "tron-usdt"
      ]
    },
    "chainFamily": {
      "enum": [
        "EVM",
        "TRON"
      ]
    },
    "network": {
      "const": "MAINNET"
    },
    "networkId": {
      "type": "string"
    },
    "assetAddress": {
      "type": "string",
      "maxLength": 64
    },
    "profileReferenceStatus": {
      "const": "STORED_RESEARCH_REFERENCE_NOT_FRESH_NETWORK_VERIFICATION"
    },
    "queryKind": {
      "enum": [
        "BALANCE",
        "ALLOWANCE"
      ]
    },
    "accounts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "enum": [
              "holder",
              "owner",
              "spender"
            ]
          },
          "address": {
            "type": "string",
            "maxLength": 64
          },
          "purpose": {
            "enum": [
              "DEPOSIT_REVIEW",
              "WITHDRAWAL_REVIEW",
              "SWEEP_REVIEW",
              "ALLOWANCE_REVIEW"
            ]
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "USER_STATEMENT",
                  "PUBLIC_REFERENCE"
                ]
              },
              "recordedAt": {
                "type": "string"
              },
              "scope": {
                "const": "ACCOUNT_PURPOSE_ONLY"
              },
              "referenceIdSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "authenticity": {
                "const": "UNKNOWN"
              }
            },
            "required": [
              "kind",
              "recordedAt",
              "scope",
              "referenceIdSha256",
              "authenticity"
            ]
          }
        },
        "required": [
          "role",
          "address",
          "purpose",
          "provenance"
        ]
      }
    },
    "pairRelation": {
      "enum": [
        "NOT_APPLICABLE",
        "SAME_ACCOUNT",
        "DISTINCT_ACCOUNTS"
      ]
    },
    "validatedAt": {
      "type": "string"
    },
    "rpcAdmission": {
      "const": "NOT_GRANTED"
    },
    "queryExecution": {
      "const": "NOT_TESTED"
    },
    "accountExistence": {
      "const": "UNKNOWN"
    },
    "serviceAccountIdentity": {
      "const": "UNKNOWN"
    },
    "ownership": {
      "const": "UNKNOWN"
    },
    "authorityState": {
      "const": "UNKNOWN"
    },
    "support": {
      "const": "UNKNOWN"
    },
    "verdict": {
      "const": "INCONCLUSIVE"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "inputStatus",
    "inputSha256",
    "inputHashEncoding",
    "profileId",
    "chainFamily",
    "network",
    "networkId",
    "assetAddress",
    "profileReferenceStatus",
    "queryKind",
    "accounts",
    "pairRelation",
    "validatedAt",
    "rpcAdmission",
    "queryExecution",
    "accountExistence",
    "serviceAccountIdentity",
    "ownership",
    "authorityState",
    "support",
    "verdict",
    "limitations"
  ]
}
