{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Qualified RLUSD deployment account candidates v1 (not AssessmentReport)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "sourceBinding": {
      "const": "UNKNOWN"
    },
    "authorityState": {
      "const": "UNKNOWN"
    },
    "support": {
      "const": "UNKNOWN"
    },
    "verdict": {
      "const": "INCONCLUSIVE"
    },
    "behaviorExecution": {
      "const": "NOT_TESTED"
    },
    "startedAt": {
      "type": "string"
    },
    "completedAt": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "provenance",
          "kind",
          "observedAt",
          "observedBlockOrSlot",
          "data"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "provenance": {
            "const": "OBSERVED"
          },
          "kind": {
            "enum": [
              "RPC",
              "RPC_ERROR"
            ]
          },
          "observedAt": {
            "type": "string"
          },
          "observedBlockOrSlot": {
            "type": "string"
          },
          "data": {}
        },
        "additionalProperties": false
      },
      "maxItems": 8
    },
    "kind": {
      "const": "QUALIFIED_RLUSD_ACCOUNT_CANDIDATES_NOT_ASSESSMENT"
    },
    "stage": {
      "enum": [
        "ERROR",
        "CANDIDATES_OBSERVED",
        "NO_MATCH_IN_RECEIPT",
        "CONSISTENCY_ERROR"
      ]
    },
    "reference": {
      "type": "object"
    },
    "sourceEvidence": {
      "type": "object"
    },
    "deployment": {
      "type": [
        "object",
        "null"
      ]
    },
    "evidenceNamespace": {
      "const": "deployment"
    },
    "requestCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "events": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "account",
          "eventSender",
          "roleId",
          "logIndex"
        ],
        "properties": {
          "account": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "eventSender": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "roleId": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          },
          "logIndex": {
            "type": "string",
            "pattern": "^0x(?:0|[1-9a-fA-F][0-9a-fA-F]*)$"
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "account",
          "selectionReason",
          "roleIds",
          "logIndices",
          "evidenceReferences",
          "membershipState",
          "accountFreezeState",
          "operatorIdentity"
        ],
        "properties": {
          "account": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "selectionReason": {
            "const": "NONZERO_ROLE_GRANTED_ACCOUNT_IN_CORROBORATED_DEPLOYMENT_RECEIPT"
          },
          "roleIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            }
          },
          "logIndices": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^0x(?:0|[1-9a-fA-F][0-9a-fA-F]*)$"
            }
          },
          "evidenceReferences": {
            "const": [
              {
                "namespace": "deployment",
                "id": "e2"
              }
            ]
          },
          "membershipState": {
            "const": "UNKNOWN"
          },
          "accountFreezeState": {
            "const": "UNKNOWN"
          },
          "operatorIdentity": {
            "const": "UNKNOWN"
          }
        }
      }
    },
    "eligibleUniqueAccounts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 128
    },
    "unselectedUniqueAccounts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 128
    },
    "membershipExecution": {
      "const": "NOT_TESTED"
    },
    "accountFreezeExecution": {
      "const": "NOT_TESTED"
    }
  },
  "required": [
    "schemaVersion",
    "sourceBinding",
    "authorityState",
    "support",
    "verdict",
    "behaviorExecution",
    "startedAt",
    "completedAt",
    "limitations",
    "evidence",
    "kind",
    "stage",
    "reference",
    "sourceEvidence",
    "deployment",
    "evidenceNamespace",
    "requestCount",
    "events",
    "candidates",
    "eligibleUniqueAccounts",
    "unselectedUniqueAccounts",
    "membershipExecution",
    "accountFreezeExecution"
  ]
}
