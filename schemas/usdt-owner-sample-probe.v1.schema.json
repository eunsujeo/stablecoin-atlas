{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Qualified USDT owner sample probe v1 (not AssessmentReport)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "sourceBinding": {
      "const": "UNKNOWN"
    },
    "authorityState": {
      "const": "UNKNOWN"
    },
    "support": {
      "const": "UNKNOWN"
    },
    "issuerVerificationStatus": {
      "const": "UNKNOWN"
    },
    "nativeOrBridged": {
      "const": "UNKNOWN"
    },
    "verdict": {
      "const": "INCONCLUSIVE"
    },
    "behaviorExecution": {
      "const": "NOT_TESTED"
    },
    "caller": {
      "const": "0x0000000000000000000000000000000000000000"
    },
    "sourceEvidence": {
      "type": "object"
    },
    "stage": {
      "enum": [
        "PRECONDITION_ERROR",
        "OBSERVED",
        "PARTIAL",
        "CONSISTENCY_ERROR"
      ]
    },
    "startedAt": {
      "type": "string"
    },
    "completedAt": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "provenance",
          "kind",
          "observedAt",
          "observedBlockOrSlot",
          "data"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "provenance": {
            "const": "OBSERVED"
          },
          "kind": {
            "enum": [
              "RPC",
              "RPC_ERROR"
            ]
          },
          "observedAt": {
            "type": "string"
          },
          "observedBlockOrSlot": {
            "type": "string"
          },
          "data": {}
        },
        "additionalProperties": false
      },
      "maxItems": 16
    },
    "kind": {
      "const": "QUALIFIED_USDT_OWNER_SAMPLE_PROBE_NOT_ASSESSMENT"
    },
    "baseProbe": {
      "type": "object"
    },
    "baseProbeSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sample": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "address",
            "classification",
            "selectionReason",
            "baseEvidenceReferences"
          ],
          "properties": {
            "address": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            "classification": {
              "const": "CONTROL_ADDRESS_SAMPLE_NOT_SERVICE_OR_CUSTOMER_ACCOUNT"
            },
            "selectionReason": {
              "const": "FRESH_MATCHING_NONZERO_OWNER_GETTER_RESPONSES"
            },
            "baseEvidenceReferences": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "namespace",
                  "id"
                ],
                "properties": {
                  "namespace": {
                    "enum": [
                      "baseProbe",
                      "ownerSample"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^e[1-9][0-9]*$"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "sampleCode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readStatus",
        "evidenceReferences",
        "recheckEvidenceReferences",
        "consistency"
      ],
      "properties": {
        "readStatus": {
          "enum": [
            "NOT_TESTED",
            "OK",
            "READ_FAILED",
            "INVALID_RESPONSE"
          ]
        },
        "evidenceReferences": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "namespace",
              "id"
            ],
            "properties": {
              "namespace": {
                "enum": [
                  "baseProbe",
                  "ownerSample"
                ]
              },
              "id": {
                "type": "string",
                "pattern": "^e[1-9][0-9]*$"
              }
            }
          }
        },
        "recheckEvidenceReferences": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "namespace",
              "id"
            ],
            "properties": {
              "namespace": {
                "enum": [
                  "baseProbe",
                  "ownerSample"
                ]
              },
              "id": {
                "type": "string",
                "pattern": "^e[1-9][0-9]*$"
              }
            }
          }
        },
        "consistency": {
          "enum": [
            "NOT_CHECKED",
            "MATCH",
            "MISMATCH",
            "NOT_ESTABLISHED"
          ]
        },
        "codePresence": {
          "enum": [
            "EMPTY",
            "PRESENT"
          ]
        },
        "codeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 131072
        },
        "codeHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "errorKind": {
          "enum": [
            "REVERT",
            "RPC_ERROR",
            "TRANSPORT_ERROR"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "readStatus": {
                "const": "OK"
              }
            }
          },
          "then": {
            "required": [
              "codePresence"
            ],
            "properties": {
              "codePresence": {}
            }
          },
          "else": {
            "not": {
              "required": [
                "codePresence"
              ],
              "properties": {
                "codePresence": {}
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "readStatus": {
                "const": "OK"
              }
            }
          },
          "then": {
            "required": [
              "codeBytes"
            ],
            "properties": {
              "codeBytes": {}
            }
          },
          "else": {
            "not": {
              "required": [
                "codeBytes"
              ],
              "properties": {
                "codeBytes": {}
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "readStatus": {
                "const": "OK"
              }
            }
          },
          "then": {
            "required": [
              "codeHash"
            ],
            "properties": {
              "codeHash": {}
            }
          },
          "else": {
            "not": {
              "required": [
                "codeHash"
              ],
              "properties": {
                "codeHash": {}
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "readStatus": {
                "const": "READ_FAILED"
              }
            }
          },
          "then": {
            "required": [
              "errorKind"
            ],
            "properties": {
              "errorKind": {}
            }
          },
          "else": {
            "not": {
              "required": [
                "errorKind"
              ],
              "properties": {
                "errorKind": {}
              }
            }
          }
        }
      ]
    },
    "readings": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "signature",
          "readStatus",
          "evidenceReferences"
        ],
        "properties": {
          "signature": {
            "enum": [
              "isBlackListed(address)",
              "getBlackListStatus(address)"
            ]
          },
          "readStatus": {
            "enum": [
              "NOT_TESTED",
              "OK",
              "READ_FAILED",
              "INVALID_RESPONSE"
            ]
          },
          "evidenceReferences": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "namespace",
                "id"
              ],
              "properties": {
                "namespace": {
                  "enum": [
                    "baseProbe",
                    "ownerSample"
                  ]
                },
                "id": {
                  "type": "string",
                  "pattern": "^e[1-9][0-9]*$"
                }
              }
            }
          },
          "value": {
            "type": "boolean"
          },
          "errorKind": {
            "enum": [
              "REVERT",
              "RPC_ERROR",
              "TRANSPORT_ERROR"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "readStatus": {
                  "const": "OK"
                }
              }
            },
            "then": {
              "required": [
                "value"
              ],
              "properties": {
                "value": {}
              }
            },
            "else": {
              "not": {
                "required": [
                  "value"
                ],
                "properties": {
                  "value": {}
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "readStatus": {
                  "const": "READ_FAILED"
                }
              }
            },
            "then": {
              "required": [
                "errorKind"
              ],
              "properties": {
                "errorKind": {}
              }
            },
            "else": {
              "not": {
                "required": [
                  "errorKind"
                ],
                "properties": {
                  "errorKind": {}
                }
              }
            }
          }
        ]
      }
    },
    "blacklistResponseComparison": {
      "enum": [
        "MATCH",
        "MISMATCH",
        "UNKNOWN"
      ]
    },
    "ownerConsistency": {
      "enum": [
        "NOT_CHECKED",
        "MATCH",
        "MISMATCH",
        "NOT_ESTABLISHED"
      ]
    },
    "ownerRecheckEvidenceReferences": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "namespace",
          "id"
        ],
        "properties": {
          "namespace": {
            "enum": [
              "baseProbe",
              "ownerSample"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^e[1-9][0-9]*$"
          }
        }
      }
    },
    "precheckEvidenceReferences": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "namespace",
          "id"
        ],
        "properties": {
          "namespace": {
            "enum": [
              "baseProbe",
              "ownerSample"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^e[1-9][0-9]*$"
          }
        }
      }
    },
    "postcheckEvidenceReferences": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "namespace",
          "id"
        ],
        "properties": {
          "namespace": {
            "enum": [
              "baseProbe",
              "ownerSample"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^e[1-9][0-9]*$"
          }
        }
      }
    },
    "requestCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16
    },
    "totalRequestCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32
    },
    "requestLimits": {
      "const": {
        "base": 16,
        "ownerSample": 16,
        "total": 32
      }
    }
  },
  "required": [
    "schemaVersion",
    "sourceBinding",
    "authorityState",
    "support",
    "issuerVerificationStatus",
    "nativeOrBridged",
    "verdict",
    "behaviorExecution",
    "caller",
    "sourceEvidence",
    "stage",
    "startedAt",
    "completedAt",
    "limitations",
    "evidence",
    "kind",
    "baseProbe",
    "baseProbeSha256",
    "sample",
    "sampleCode",
    "readings",
    "blacklistResponseComparison",
    "ownerConsistency",
    "ownerRecheckEvidenceReferences",
    "precheckEvidenceReferences",
    "postcheckEvidenceReferences",
    "requestCount",
    "totalRequestCount",
    "requestLimits"
  ]
}
