{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Qualified USDT control probe v1 (not AssessmentReport)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "kind": {
      "const": "QUALIFIED_USDT_CONTROL_PROBE_NOT_ASSESSMENT"
    },
    "sourceBinding": {
      "const": "UNKNOWN"
    },
    "verdict": {
      "const": "INCONCLUSIVE"
    },
    "support": {
      "const": "UNKNOWN"
    },
    "authorityState": {
      "const": "UNKNOWN"
    },
    "issuerVerificationStatus": {
      "const": "UNKNOWN"
    },
    "nativeOrBridged": {
      "const": "UNKNOWN"
    },
    "behaviorExecution": {
      "const": "NOT_TESTED"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "networkId",
        "target",
        "codeHash"
      ],
      "properties": {
        "networkId": {
          "const": "1"
        },
        "target": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "codeHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        }
      }
    },
    "caller": {
      "const": "0x0000000000000000000000000000000000000000"
    },
    "stage": {
      "enum": [
        "PRECONDITION_ERROR",
        "OBSERVED",
        "PARTIAL",
        "CONSISTENCY_ERROR"
      ]
    },
    "initial": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "blockNumber",
            "blockHash",
            "codeHash"
          ],
          "properties": {
            "blockNumber": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "blockHash": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{64}$"
            },
            "codeHash": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{64}$"
            }
          }
        }
      ]
    },
    "readings": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "signature",
          "readStatus",
          "evidenceReferences"
        ],
        "properties": {
          "signature": {
            "enum": [
              "owner()",
              "getOwner()",
              "paused()",
              "deprecated()",
              "upgradedAddress()",
              "basisPointsRate()",
              "maximumFee()"
            ]
          },
          "readStatus": {
            "enum": [
              "NOT_TESTED",
              "OK",
              "READ_FAILED",
              "INVALID_RESPONSE"
            ]
          },
          "evidenceReferences": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^e[1-9][0-9]*$"
            },
            "uniqueItems": true
          },
          "value": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              }
            ]
          },
          "errorKind": {
            "enum": [
              "REVERT",
              "RPC_ERROR",
              "TRANSPORT_ERROR"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "readStatus": {
                  "const": "OK"
                }
              }
            },
            "then": {
              "required": [
                "value"
              ],
              "properties": {
                "value": {}
              }
            },
            "else": {
              "not": {
                "required": [
                  "value"
                ],
                "properties": {
                  "value": {}
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "readStatus": {
                  "const": "READ_FAILED"
                }
              }
            },
            "then": {
              "required": [
                "errorKind"
              ],
              "properties": {
                "errorKind": {}
              }
            },
            "else": {
              "not": {
                "required": [
                  "errorKind"
                ],
                "properties": {
                  "errorKind": {}
                }
              }
            }
          }
        ]
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "provenance",
          "kind",
          "observedAt",
          "observedBlockOrSlot",
          "data"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "provenance": {
            "const": "OBSERVED"
          },
          "kind": {
            "enum": [
              "RPC",
              "RPC_ERROR",
              "BLOCK_REFERENCE",
              "BLOCK_REFERENCE_ERROR"
            ]
          },
          "observedAt": {
            "type": "string"
          },
          "observedBlockOrSlot": {
            "type": "string"
          },
          "data": {}
        },
        "additionalProperties": false
      },
      "maxItems": 18
    },
    "sourceEvidence": {
      "type": "object"
    },
    "startedAt": {
      "type": "string"
    },
    "completedAt": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string"
      }
    },
    "precheckEvidenceReferences": {
      "type": "array",
      "maxItems": 26,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^e[1-9][0-9]*$"
      }
    },
    "postcheckEvidenceReferences": {
      "type": "array",
      "maxItems": 26,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^e[1-9][0-9]*$"
      }
    },
    "requestCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16
    },
    "skipped": {
      "const": [
        {
          "signature": "isBlackListed(address)",
          "execution": "NOT_TESTED",
          "reason": "NO_JUSTIFIED_ACCOUNT_SAMPLE"
        },
        {
          "signature": "getBlackListStatus(address)",
          "execution": "NOT_TESTED",
          "reason": "NO_JUSTIFIED_ACCOUNT_SAMPLE"
        }
      ]
    },
    "ownerResponseComparison": {
      "enum": [
        "MATCH",
        "MISMATCH",
        "UNKNOWN"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "sourceBinding",
    "verdict",
    "support",
    "authorityState",
    "issuerVerificationStatus",
    "nativeOrBridged",
    "behaviorExecution",
    "reference",
    "caller",
    "stage",
    "initial",
    "readings",
    "evidence",
    "startedAt",
    "completedAt",
    "limitations",
    "sourceEvidence",
    "precheckEvidenceReferences",
    "postcheckEvidenceReferences",
    "requestCount",
    "skipped",
    "ownerResponseComparison"
  ]
}
