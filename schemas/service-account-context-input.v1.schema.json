{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Local service-account purpose claim input, not ownership proof",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "contextKind": {
      "const": "SERVICE_ACCOUNT_PURPOSE_CLAIM"
    },
    "profileId": {
      "enum": [
        "ethereum-usdc",
        "ethereum-usdt",
        "ethereum-rlusd",
        "tron-usdt"
      ]
    },
    "chainFamily": {
      "enum": [
        "EVM",
        "TRON"
      ]
    },
    "network": {
      "const": "MAINNET"
    },
    "networkId": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,9}$"
    },
    "assetAddress": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "query": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "BALANCE"
            },
            "holder": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "address": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "purpose": {
                  "enum": [
                    "DEPOSIT_REVIEW",
                    "WITHDRAWAL_REVIEW",
                    "SWEEP_REVIEW",
                    "ALLOWANCE_REVIEW"
                  ]
                },
                "provenance": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "USER_STATEMENT",
                        "PUBLIC_REFERENCE"
                      ]
                    },
                    "referenceId": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
                    },
                    "recordedAt": {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
                    },
                    "scope": {
                      "const": "ACCOUNT_PURPOSE_ONLY"
                    }
                  },
                  "required": [
                    "kind",
                    "referenceId",
                    "recordedAt",
                    "scope"
                  ]
                }
              },
              "required": [
                "address",
                "purpose",
                "provenance"
              ]
            }
          },
          "required": [
            "kind",
            "holder"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "ALLOWANCE"
            },
            "owner": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "address": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "purpose": {
                  "enum": [
                    "DEPOSIT_REVIEW",
                    "WITHDRAWAL_REVIEW",
                    "SWEEP_REVIEW",
                    "ALLOWANCE_REVIEW"
                  ]
                },
                "provenance": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "USER_STATEMENT",
                        "PUBLIC_REFERENCE"
                      ]
                    },
                    "referenceId": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
                    },
                    "recordedAt": {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
                    },
                    "scope": {
                      "const": "ACCOUNT_PURPOSE_ONLY"
                    }
                  },
                  "required": [
                    "kind",
                    "referenceId",
                    "recordedAt",
                    "scope"
                  ]
                }
              },
              "required": [
                "address",
                "purpose",
                "provenance"
              ]
            },
            "spender": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "address": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "purpose": {
                  "enum": [
                    "DEPOSIT_REVIEW",
                    "WITHDRAWAL_REVIEW",
                    "SWEEP_REVIEW",
                    "ALLOWANCE_REVIEW"
                  ]
                },
                "provenance": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "USER_STATEMENT",
                        "PUBLIC_REFERENCE"
                      ]
                    },
                    "referenceId": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
                    },
                    "recordedAt": {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
                    },
                    "scope": {
                      "const": "ACCOUNT_PURPOSE_ONLY"
                    }
                  },
                  "required": [
                    "kind",
                    "referenceId",
                    "recordedAt",
                    "scope"
                  ]
                }
              },
              "required": [
                "address",
                "purpose",
                "provenance"
              ]
            }
          },
          "required": [
            "kind",
            "owner",
            "spender"
          ]
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "contextKind",
    "profileId",
    "chainFamily",
    "network",
    "networkId",
    "assetAddress",
    "query"
  ]
}
